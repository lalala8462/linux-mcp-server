#!/usr/bin/python -BEs
# -*- coding: utf-8 -*-
"""只接受固定 JSON 读取请求的 root helper，兼容 Python 2.6/3.x。"""

from __future__ import print_function

import json
import os
import pwd
import re
import select
import signal
import stat
import subprocess
import sys


POLICY_PATH = "/etc/linux-mcp-readonly/policy.json"
HELPER_PATH = "/usr/local/libexec/linux-mcp-privileged-read"
MAX_REQUEST = 8192
MAX_OUTPUT = 1048577
TIMEOUT = 20
FD_ROOT = "/proc/self/fd"
BINARY_DIRS = ("/usr/bin", "/bin", "/usr/sbin", "/sbin")
try:
    TEXT_TYPE = unicode  # pyright: ignore[reportUndefinedVariable]
except NameError:
    TEXT_TYPE = str


class ReadDenied(Exception):
    """请求、身份或路径超出受控读取边界。"""


def text(value):
    if isinstance(value, bytes):
        return value.decode("utf-8", "strict")
    return value


def fs_path(value):
    if sys.version_info[0] < 3 and isinstance(value, TEXT_TYPE):
        return value.encode("utf-8")
    return value


def trusted_path(path, kind):
    """验证固定程序/策略及全部父目录，拒绝可被普通用户替换的路径。"""
    current = "/"
    root = os.lstat(current)
    if root.st_uid != 0 or root.st_mode & 0o022 or not stat.S_ISDIR(root.st_mode):
        raise ReadDenied("untrusted root directory")
    for component in path.strip("/").split("/"):
        current = os.path.join(current, component)
        info = os.lstat(current)
        if stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ReadDenied("untrusted root-controlled path")
    valid = stat.S_ISREG(info.st_mode) if kind == "file" else stat.S_ISDIR(info.st_mode)
    if not valid:
        raise ReadDenied("unexpected trusted path type")


def require_identity():
    if len(sys.argv) != 1 or os.getuid() != 0 or os.geteuid() != 0:
        raise ReadDenied("helper requires root and no command-line arguments")
    trusted_path(HELPER_PATH, "file")
    # 环境变量只作补充；检查内核父进程身份，兼容 sudo 的监护与直接 exec 模式。
    account = pwd.getpwnam("codex-ro")
    if account.pw_uid == 0 or os.environ.get("SUDO_UID") != str(account.pw_uid):
        raise ReadDenied("sudo caller is not codex-ro")
    parent = "/proc/%s" % os.getppid()
    executable = os.path.realpath(parent + "/exe")
    with open(parent + "/status", "rb") as stream:
        status = stream.read(8192)
    match = re.search(r"(?m)^Uid:\s+([0-9]+)\s+([0-9]+)\s+[0-9]+\s+[0-9]+\s*$", text(status))
    if match is None:
        raise ReadDenied("parent kernel identity unavailable")
    real_uid, effective_uid = int(match.group(1)), int(match.group(2))
    if executable in ("/usr/bin/sudo", "/bin/sudo") and effective_uid == 0:
        trusted_path(executable, "file")
    elif real_uid != account.pw_uid or effective_uid != account.pw_uid:
        raise ReadDenied("sudo parent identity mismatch")
    # 直接 exec 时父进程仍为 codex-ro；root:root 0700 入口与精确 sudoers 约束提权。


def clean_path(value):
    if not isinstance(value, TEXT_TYPE) or not value.startswith("/"):
        raise ReadDenied("path must be absolute text")
    if any(character in value for character in ("\x00", "\r", "\n", "\t")):
        raise ReadDenied("path contains control characters")
    if value != "/" and any(part in ("", ".", "..") for part in value[1:].split("/")):
        raise ReadDenied("path contains ambiguous components")
    value.encode("utf-8", "strict")
    return value


def within(path, roots):
    if not any(path == root or path.startswith(root + "/") for root in roots):
        raise ReadDenied("path is outside approved roots")


def load_policy():
    trusted_path(POLICY_PATH, "file")
    with open(POLICY_PATH, "rb") as stream:
        payload = stream.read(MAX_REQUEST + 1)
    if len(payload) > MAX_REQUEST:
        raise ReadDenied("policy too large")
    policy = json.loads(text(payload))
    if policy.get("read_mode", "user") != "privileged":
        raise ReadDenied("privileged read mode is not enabled")
    if "allowed_roots" in policy and "allowed_root" in policy:
        raise ReadDenied("ambiguous roots")
    roots = policy.get("allowed_roots", [policy.get("allowed_root")])
    if not isinstance(roots, list) or not 1 <= len(roots) <= 16:
        raise ReadDenied("invalid approved roots")
    roots = [clean_path(root) for root in roots]
    if "/" in roots or len(set(roots)) != len(roots):
        raise ReadDenied("unsafe approved roots")
    for index, root in enumerate(roots):
        for other in roots[index + 1 :]:
            if other.startswith(root + "/") or root.startswith(other + "/"):
                raise ReadDenied("overlapping approved roots")
    maximum = policy.get("max_file_read_bytes", 1048576)
    lines = policy.get("max_log_lines", 10000)
    if type(maximum) is not int or not 1 <= maximum <= 1048576:
        raise ReadDenied("invalid byte limit")
    if type(lines) is not int or not 1 <= lines <= 10000:
        raise ReadDenied("invalid line limit")
    return {"roots": roots, "bytes": maximum, "lines": lines}


def fd_path(descriptor):
    return FD_ROOT + "/" + str(descriptor)


def open_path(path, roots, kind):
    """逐层 O_NOFOLLOW 打开，再核对最终描述符的真实路径，特殊文件不阻塞。"""
    path = clean_path(path)
    within(path, roots)
    if not hasattr(os, "O_NOFOLLOW") or not hasattr(os, "O_DIRECTORY"):
        raise ReadDenied("safe open is unavailable")
    descriptor = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    parts = path[1:].split("/")
    try:
        for index, component in enumerate(parts):
            directory = index < len(parts) - 1 or kind == "directory"
            flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
            if directory:
                flags |= os.O_DIRECTORY
            candidate = fs_path(fd_path(descriptor) + "/" + component)
            before = os.lstat(candidate)
            if not (stat.S_ISDIR(before.st_mode) if directory else stat.S_ISREG(before.st_mode)):
                raise ReadDenied("symlinks and special files are not allowed")
            child = os.open(candidate, flags)
            os.close(descriptor)
            descriptor = child
        info = os.fstat(descriptor)
        expected = stat.S_ISREG(info.st_mode) if kind == "file" else stat.S_ISDIR(info.st_mode)
        if not expected:
            raise ReadDenied("special files are not allowed")
        # 拒绝硬链接文件，避免低权限目录中的别名引入范围外敏感 inode。
        if kind == "file" and info.st_nlink != 1:
            raise ReadDenied("hard-linked files are not allowed")
        opened = text(os.readlink(fd_path(descriptor)))
        if opened != path:
            raise ReadDenied("opened path changed or contains a symlink")
        within(opened, roots)
        if hasattr(os, "set_inheritable"):
            os.set_inheritable(descriptor, True)
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def trusted_binary(name):
    for directory in BINARY_DIRS:
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate):
            resolved = os.path.realpath(candidate)
            trusted_path(resolved, "file")
            return resolved
    raise ReadDenied("required fixed binary is missing")


def fixed_listing(command):
    """只运行内部构造的 find/du 参数数组，限制两个输出流并回收子进程组。"""
    process = subprocess.Popen(
        command,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        close_fds=False,
        preexec_fn=os.setsid,
        env={"PATH": ":".join(BINARY_DIRS), "LANG": "C", "LC_ALL": "C"},
    )
    chunks = []
    size = 0
    errors = 0
    try:
        process.stdin.close()
        pending = [process.stdout, process.stderr]
        while pending:
            ready, _, _ = select.select(pending, [], [], 0.25)
            for stream in ready:
                data = os.read(stream.fileno(), 65536)
                if not data:
                    pending.remove(stream)
                elif stream is process.stdout:
                    size += len(data)
                    if size > MAX_OUTPUT:
                        raise ReadDenied("directory output exceeds limit")
                    chunks.append(data)
                else:
                    errors += len(data)
                    if errors > 16384:
                        raise ReadDenied("directory error output exceeds limit")
        if process.wait() != 0:
            raise ReadDenied("directory scan failed; partial output is not accepted")
        return b"".join(chunks)
    finally:
        if process.poll() is None:
            os.killpg(process.pid, signal.SIGKILL)
        process.wait()
        process.stdout.close()
        process.stderr.close()


def tail_bytes(descriptor, count, maximum):
    info = os.fstat(descriptor)
    start = max(0, info.st_size - maximum)
    os.lseek(descriptor, max(0, start - 1), os.SEEK_SET)
    data = os.read(descriptor, maximum + (1 if start else 0))
    boundary = not start or data[:1] == b"\n"
    if start:
        data = data[1:]
    trailing = data.endswith(b"\n")
    records = data.split(b"\n")
    if trailing:
        records.pop()
    if not boundary:
        records = records[1:]
    if start and len(records) < count:
        raise ReadDenied("requested log tail exceeds byte limit")
    result = b"\n".join(records[-count:])
    if trailing:
        result += b"\n"
    return result


def parse_request(raw, policy):
    if len(raw) > MAX_REQUEST:
        raise ReadDenied("request too large")
    request = json.loads(text(raw))
    if not isinstance(request, dict) or set(request) != set(("version", "op", "path", "limit", "format")):
        raise ReadDenied("invalid request fields")
    if type(request["version"]) is not int or request["version"] != 1:
        raise ReadDenied("invalid request version")
    if request["op"] not in ("read", "tail", "stat", "list_files", "list_dirs", "directory_sizes"):
        raise ReadDenied("operation is not allowed")
    clean_path(request["path"])
    within(request["path"], policy["roots"])
    limit = request["limit"]
    if type(limit) is not int:
        raise ReadDenied("invalid request limit")
    maximum = policy["lines"] if request["op"] == "tail" else policy["bytes"] + 1
    if request["op"] in ("read", "tail"):
        if not 1 <= limit <= maximum:
            raise ReadDenied("request limit exceeds policy")
    elif limit != 0:
        raise ReadDenied("unexpected limit")
    formats = ("name", "modified", "size") if request["op"] in ("list_files", "list_dirs") else ("",)
    if request["format"] not in formats or (request["op"] == "list_dirs" and request["format"] == "size"):
        raise ReadDenied("invalid listing format")
    return request


def execute_request(request, policy):
    operation = request["op"]
    kind = "file" if operation in ("read", "tail", "stat") else "directory"
    descriptor = open_path(request["path"], policy["roots"], kind)
    try:
        if operation == "read":
            return os.read(descriptor, request["limit"])
        if operation == "tail":
            return tail_bytes(descriptor, request["limit"], policy["bytes"])
        if operation == "stat":
            return (str(os.fstat(descriptor).st_size) + "\n").encode("ascii")
        path = fd_path(descriptor)
        if operation == "directory_sizes":
            command = [trusted_binary("du"), "-H", "--block-size=1", "--one-file-system", "--max-depth=1", path]
        else:
            formats = {"name": "%f\\n", "modified": "%T@\\t%f\\n", "size": "%s\\t%f\\n"}
            command = [
                trusted_binary("find"),
                "-H",
                path,
                "-mindepth",
                "1",
                "-maxdepth",
                "1",
                "-type",
                "f" if operation == "list_files" else "d",
                "-printf",
                formats[request["format"]],
            ]
        return fixed_listing(command)
    finally:
        os.close(descriptor)


def timed_out(_number, _frame):
    raise ReadDenied("privileged read timed out")


def main():
    try:
        signal.signal(signal.SIGALRM, timed_out)
        signal.signal(signal.SIGTERM, timed_out)
        signal.signal(signal.SIGHUP, timed_out)
        signal.alarm(TIMEOUT)
        require_identity()
        policy = load_policy()
        source = getattr(sys.stdin, "buffer", sys.stdin)
        request = parse_request(source.read(MAX_REQUEST + 1), policy)
        result = execute_request(request, policy)
        if len(result) > MAX_OUTPUT:
            raise ReadDenied("output exceeds limit")
        target = getattr(sys.stdout, "buffer", sys.stdout)
        target.write(result)
        target.flush()
        return 0
    except Exception as error:
        message = TEXT_TYPE(error).encode("utf-8", "replace")
        target = getattr(sys.stderr, "buffer", sys.stderr)
        target.write(b"privileged read denied: " + message + b"\n")
        return 126
    finally:
        signal.alarm(0)


if __name__ == "__main__":
    sys.exit(main())
